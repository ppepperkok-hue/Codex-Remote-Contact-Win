# 复制为 data/hub.env 后按本机情况修改（该文件不入库）。
# 已存在的系统环境变量会优先于这里的值。

# NapCat OneBot 正向 WebSocket 地址
ONEBOT_WS_URL=ws://127.0.0.1:3001

# 开机自动启动的服务 id（逗号分隔，与 data/services.json 里的 key 对应）
AUTO_START_SERVICES=

# 监听地址：局域网/公网访问用 0.0.0.0，仅本机用 127.0.0.1
CODEX_REMOTE_CONTACT_HOST=127.0.0.1

# 额外信任的 Host 主机名（逗号分隔，可选）
# 无密码模式默认只信任绑定地址与 localhost / 127.0.0.1，用于防止 DNS rebinding。
CODEX_REMOTE_CONTACT_ALLOWED_HOSTS=

# 访问密码（也可放在 data/access-token.txt，优先取环境变量）
# 非本机访问、以及 POST /api/onebot/event、/api/qq/event 事件注入接口必须配置。
CODEX_REMOTE_CONTACT_ACCESS_TOKEN=

# 远程执行沙箱：read-only | workspace-write | danger-full-access
# 留空则使用 data/settings.json；设置后优先级最高，会覆盖文件里的选择。
CODEX_REMOTE_CONTACT_REMOTE_EXECUTION_SANDBOX=
